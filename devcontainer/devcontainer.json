{
  "name": "SigVerify - Digital Signature Validator",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install fastapi uvicorn python-multipart pyhanko pyhanko-certvalidator",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "SigVerify API",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
